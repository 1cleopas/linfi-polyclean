ADMIN_PASSWORD=change-this-password
# Postgres connection string. Leave blank to store data in local JSON files (DATA_DIR or ./data).
DATABASE_URL=
DATA_DIR=
PORT=3000

# ---- Booking alerts and customer confirmations (all optional) ----
# Email through Resend (resend.com). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=LINFI POLYCLEAN <bookings@linfipolyclean.com>
# Where new-booking alerts go. Comma-separated.
ALERT_EMAILS=info@linfipolyclean.com
# SMS through Arkesel (arkesel.com). The sender ID (max 11 characters) must be approved by Arkesel.
ARKESEL_API_KEY=
SMS_SENDER_ID=LINFI
# Phone numbers that get new-booking SMS alerts. Comma-separated, local or 233 format.
ALERT_PHONES=0599842689
# Set to off to stop the SMS/email confirmation sent to customers.
CUSTOMER_CONFIRMATIONS=on
# 1 = log messages instead of sending them (for testing). SMS_SANDBOX=1 uses Arkesel's sandbox.
NOTIFY_DRY_RUN=
SMS_SANDBOX=
